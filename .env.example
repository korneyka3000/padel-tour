# Copy to .env and fill in. Never commit .env.
# Names only — see docs/INFRASTRUCTURE.md for where each value comes from.

# --- M2: database ---------------------------------------------------------
# Leave unset to use a local SQLite file during development.
DATABASE_URL=
DATABASE_URL_TEST=

# --- M3: Telegram bot -----------------------------------------------------
BOT_TOKEN=
# Only needed once the bot runs behind a webhook instead of polling.
TELEGRAM_WEBHOOK_SECRET=

# --- M5: accounts ---------------------------------------------------------
# Plain SMTP, so no provider lock-in and no domain needed to start. Gmail works with an
# app password (requires 2FA); use a dedicated account rather than a personal one.
# Leave unset and sign-in links are written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- M6.5: Telegram Mini App ----------------------------------------------
# Enable with @BotFather: /mybots → the bot → Bot Settings → Configure Mini App →
# Enable Mini App, pointed at PUBLIC_BASE_URL. Then the chart button opens the site inside
# Telegram, already signed in — no SMTP needed to get into the web at all.
# Only the username: a Main Mini App launches from t.me/<bot>?startapp=… with no app short
# name. Unset, the button still works; it just opens the in-app browser as a stranger.
BOT_USERNAME=

# Telegram user ids allowed everywhere, comma separated. A capability on the ordinary
# screens rather than a separate admin panel: somebody fixing a group's tournament needs
# the screens that group uses. Being listed adds permission; an admin is still a player.
ADMIN_TELEGRAM_IDS=

# --- M4: API and web ------------------------------------------------------
# Public base URL of the deployment, without a trailing slash. Used for the Telegram
# webhook and for the sign-in links sent by email. Must be https in production: it is also
# what decides whether the session cookie is marked Secure.
# Unset means http://localhost:5173, the Vite dev server.
PUBLIC_BASE_URL=
